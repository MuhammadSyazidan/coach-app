{
  "expo": {
    "name": "Pelatih",
    "slug": "pelatih",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pelatih",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "id.pelatih.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E4572E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.VIBRATE", "android.permission.POST_NOTIFICATIONS", "android.permission.READ_CALENDAR", "android.permission.WRITE_CALENDAR"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      ["expo-calendar", { "calendarPermission": "Pelatih menulis jadwal latihan ke Google Calendar dan membaca waktu sibukmu." }],
      ["expo-notifications", { "color": "#E4572E" }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E4572E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
